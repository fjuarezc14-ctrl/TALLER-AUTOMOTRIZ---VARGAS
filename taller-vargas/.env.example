# =========================================================
# TALLER VARGAS — Variables de entorno (RAÍZ)
# =========================================================
# 1. Copiar este archivo:  cp .env.example .env
# 2. Ajustar valores según el entorno (dev o producción)
# 3. Nunca subir .env al repositorio
# =========================================================

# ── Frontend (Vite) ──────────────────────────────────────
# URL base del API. Vite la embebe en el build de producción.

# Desarrollo local (Docker o npm run dev):
VITE_API_URL=http://localhost:3001

# Producción con nginx en el MISMO dominio (recomendado, dejar vacío):
# VITE_API_URL=

# Producción con API en otro dominio/subdominio:
# VITE_API_URL=https://api.tudominio.com

# ── Puertos expuestos en el HOST (solo docker-compose dev) ─
WEB_PORT=5174
BACKEND_PORT=3001
DB_PORT=5436

# ── PostgreSQL (usado por docker-compose) ────────────────
DB_USER=vargas_user
DB_PASSWORD=CAMBIAR_PASSWORD
DB_NAME=taller_vargas_db
DATABASE_URL=postgresql://vargas_user:CAMBIAR_PASSWORD@db:5432/taller_vargas_db
