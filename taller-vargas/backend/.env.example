# =========================================================
# TALLER VARGAS — Variables de entorno (BACKEND)
# =========================================================
# 1. Copiar este archivo:  cp .env.example .env
# 2. Cambiar credenciales y URLs antes de producción
# 3. Nunca subir .env al repositorio
# =========================================================

PORT=3001
NODE_ENV=development

# ── Base de datos ────────────────────────────────────────
# Docker (servicio "db" en la red interna):
DATABASE_URL=postgresql://vargas_user:CAMBIAR_PASSWORD@db:5432/taller_vargas_db

# Conexión directa desde el host (solo desarrollo local):
DB_HOST=localhost
DB_PORT=5436
DB_USER=vargas_user
DB_PASSWORD=CAMBIAR_PASSWORD
DB_NAME=taller_vargas_db

# ── Seguridad ────────────────────────────────────────────
JWT_SECRET=generar_un_secreto_largo_y_aleatorio_en_produccion
ADMIN_PIN=1234

# ── CORS ─────────────────────────────────────────────────
# Desarrollo:
CORS_ORIGIN=http://localhost:5174

# Producción (dominio real del frontend):
# CORS_ORIGIN=https://tudominio.com
